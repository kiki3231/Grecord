# ──────────────── IDE / Editor ────────────────
.idea/
.vscode/
*.iml
*.iws
*.ipr
.idea_modules/
.history/
*.swp
*.swo
*.swn

# 保留前端团队共享的推荐扩展配置
!frontend/.vscode/
!frontend/.vscode/extensions.json

# ──────────────── OS 临时文件 ────────────────
.DS_Store
Thumbs.db
ehthumbs.db
desktop.ini
$RECYCLE.BIN/

# ──────────────── Java / Maven / Gradle ────────────────
**/target/
**/build/
*.class
*.log
hs_err_pid*
replay_pid*
HELP.md
.mvn/wrapper/maven-wrapper.properties

# ──────────────── Node / Vite / Frontend ────────────────
**/node_modules/
**/dist/
**/dist-ssr/
**/.vite/
**/coverage/
*.local
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# ──────────────── Python / Scrapy ────────────────
**/__pycache__/
*.py[cod]
*$py.class
*.egg-info/
.eggs/
.venv/
venv/
env/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Scrapy 中间产物（保留 spider 源码，不保留运行时输出）
.scrapy/
*.crawl
**/game_scrapy/*.log

# ──────────────── 项目本地 / 敏感配置 ────────────────
# Cursor / 本地工具锁文件
skills-lock.json

# 临时脚本与本地工具配置
.commit_msg.txt
*.tmp
*.bak

# 本地化的 Spring 配置（如有则不入库，模板见 application.yml）
backend/src/main/resources/application-local.yml
backend/src/main/resources/application-secret.yml

# 用户上传头像（运行时写入 data/avatar）
data/avatar/

# ──────────────── 不入库的大文件 / 二进制 ────────────────
*.zip
*.rar
*.7z
*.tar
*.tar.gz
*.tgz
